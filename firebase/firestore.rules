rules_version = '2';

// Atlas AI Firestore security rules.
//
// Access model:
// - Only approved users can read/write any data: a bootstrap admin, an admin
//   in config/access.adminEmails, an account whose profile has
//   accessStatus == 'approved' (set only by the server after an
//   administrator approves it), or an email on the legacy allowlist
//   config/access.allowedEmails (unless the profile is 'rejected').
// - Admin and allowlist matches need a VERIFIED email (verified()). An
//   approved account may use the app with a verified email OR a verified
//   phone number (member()), so people can verify their email later; the
//   server keeps sensitive actions for verified emails.
// - Access requests (accessRequests/{uid}) are written only by the server;
//   administrators can read them, nobody else.
// - The server signs in as its own Firebase identity (uid atlas-server with
//   the atlasServer custom claim, mintable only with the service account
//   key) and may read and write every document: isServer().
// - Email/password sign-ins additionally need the phoneVerified custom claim,
//   which only the server sets after a correct SMS code. Google and Apple
//   sign-ins do not need it.
// - Suspended or deleted accounts, and sessions that started before a
//   revocation (users/{uid}.sessionsValidAfter), are refused everywhere:
//   accountActive() is part of verified().
// - One-time-code and recovery records (otp, otpPhones, otpStats, otpRecovery,
//   recovery, rateLimits) and phone ownership (phoneNumbers) are server-only:
//   no client rule matches them, so the catch-all at the bottom denies every
//   read and write.
// - Security events (users/{uid}/securityEvents) and admin activity logs
//   (adminLogs) are written only by the server; owners / admins can read them.
// - Support reports (supportReports and subcollections), administrator
//   notifications and help articles are written only by the server. Users
//   read only their own reports; internal notes are administrator-only.
// - Every account must have accepted the current Terms of Use and Privacy
//   Policy (users/{uid}.consent, server-written) before any data access:
//   consentOk() is part of isAllowed().
// - Every user-owned record lives under users/{uid}/... and is only
//   accessible to that uid. Admins cannot read other users' data.
// - The backend talks to Firestore with the caller's own ID token, so these
//   rules also govern every server-side read/write.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    // The backend's own identity (see serverIdToken in server/admin.ts).
    function isServer() {
      return request.auth != null
        && request.auth.uid == 'atlas-server'
        && request.auth.token.get('atlasServer', false) == true;
    }
    function phoneOk() {
      return request.auth.token.firebase.sign_in_provider != 'password'
        || request.auth.token.get('phoneVerified', false) == true;
    }
    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    // Account not suspended or deleted, and this session not revoked.
    function accountActive() {
      return !exists(profilePath())
        || (get(profilePath()).data.get('accountStatus', 'active') == 'active'
          && request.auth.token.auth_time >= get(profilePath()).data.get('sessionsValidAfter', 0));
    }
    function verified() {
      return signedIn() && request.auth.token.email_verified == true && phoneOk() && accountActive();
    }
    // Verified email or verified phone (the phoneVerified claim is set only by the server).
    function member() {
      return signedIn()
        && (request.auth.token.email_verified == true || request.auth.token.get('phoneVerified', false) == true)
        && phoneOk() && accountActive();
    }
    function serverOnlyProfileKeys() {
      return ['phoneNumber', 'phoneVerified', 'phoneVerifiedAt', 'accountStatus', 'sessionsValidAfter',
        'suspendedAt', 'suspendedReason', 'deletionScheduledAt', 'purgeAfter', 'lastAuthTime',
        'accessStatus', 'approvedAt', 'approvedBy', 'rejectedAt', 'rejectedBy', 'accessRequestedAt', 'consent',
        'removedDevices'];
    }
    function email() {
      return request.auth.token.email.lower();
    }
    function accessPath() {
      return /databases/$(database)/documents/config/access;
    }
    function accessDoc() {
      return get(accessPath()).data;
    }
    // Keep in sync with ADMIN_EMAILS on the server.
    function isBootstrapAdmin() {
      return verified() && email() in ['kingsleyanaab604@gmail.com'];
    }
    function isAdmin() {
      return consentOk() && (isBootstrapAdmin()
        || (verified() && exists(accessPath()) && email() in accessDoc().get('adminEmails', [])));
    }
    function accessStatus() {
      return exists(profilePath()) ? get(profilePath()).data.get('accessStatus', '') : '';
    }
    // The current Terms of Use and Privacy Policy are accepted (users/{uid}.consent, written only
    // by the server). Keep the versions in sync with server/shared/legal.ts. During a version change
    // the previous version is also accepted here, so publishing these rules before the new app is
    // deployed never locks anyone out; the server asks everyone to accept the new version.
    function consentOk() {
      return exists(profilePath())
        && get(profilePath()).data.get('consent', {}).get('termsVersion', '') in ['1.3', '1.4']
        && get(profilePath()).data.get('consent', {}).get('privacyVersion', '') in ['1.3', '1.4'];
    }
    function isAllowed() {
      return consentOk() && (
        isAdmin()
        || (member() && accessStatus() == 'approved')
        || (verified() && accessStatus() != 'rejected'
          && exists(accessPath()) && email() in accessDoc().get('allowedEmails', [])));
    }
    function isOwner(uid) {
      return isAllowed() && request.auth.uid == uid;
    }
    function smallString(v, max) {
      return v is string && v.size() <= max;
    }

    // Public flags the sign-in screen needs before authentication.
    match /config/public {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['registrationOpen', 'updatedAt'])
        && request.resource.data.registrationOpen is bool;
    }

    // Allowlist. Readable by approved users (so the client can show status),
    // writable only by admins.
    match /config/access {
      allow read: if isAllowed();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['allowedEmails', 'adminEmails', 'updatedAt'])
        && request.resource.data.allowedEmails is list
        && request.resource.data.allowedEmails.size() <= 200
        && request.resource.data.get('adminEmails', []) is list;
    }

    // Automatic approval of new accounts. Changed only through the server (api/admin
    // setAutoApprove, which checks the administrator and writes an audit entry).
    match /config/approval {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Cost limits for web search / deep research. Readable by approved users
    // (the server reads them with the caller's token), writable by admins.
    match /config/limits {
      allow read: if isAllowed();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['serpapi', 'tavily', 'research', 'cacheTtlHours', 'providerReserve', 'autoReserve', 'images', 'updatedAt'])
        && request.resource.data.get('serpapi', {}) is map
        && request.resource.data.get('tavily', {}) is map
        && request.resource.data.get('research', {}) is map
        && request.resource.data.get('cacheTtlHours', {}) is map
        && request.resource.data.get('images', {}) is map
        && request.resource.data.get('providerReserve', 0) is int
        && request.resource.data.get('autoReserve', 0) is int;
    }

    // Admin AI settings: preferred provider, default model, fallback policy.
    match /config/ai {
      allow read: if isAllowed();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['preferredProvider', 'defaultModel', 'fallback', 'updatedAt'])
        && request.resource.data.get('preferredProvider', 'gemini') in ['gemini', 'openrouter', 'cloudflare']
        && request.resource.data.get('fallback', 'any') in ['any', 'same_provider', 'off']
        && (request.resource.data.get('defaultModel', null) == null || smallString(request.resource.data.defaultModel, 120));
    }

    match /config/{other} {
      allow read, write: if false;
    }

    // Shared knowledge collections: every approved user can read (so retrieval
    // can use them); only admins can add, change or delete.
    match /kb/shared/kbCollections/{cid} {
      allow read: if isAllowed();
      allow delete: if isAdmin();
      allow create, update: if isAdmin() && smallString(request.resource.data.name, 100);
    }
    match /kb/shared/kbSources/{sid} {
      allow read: if isAllowed();
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && smallString(request.resource.data.title, 300)
        && smallString(request.resource.data.collectionId, 128);
      match /{sub}/{subId} {
        allow read: if isAllowed() && sub in ['chunks', 'index'];
        allow write: if isAdmin() && sub in ['chunks', 'index'];
      }
    }

    match /users/{uid} {
      // Phone fields, account status and session revocation are written only by the server.
      // Deleting the account record is an administrator (server) operation.
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && !request.resource.data.keys().hasAny(serverOnlyProfileKeys());
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverOnlyProfileKeys());

      match /securityEvents/{eid} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Every Terms of Use / Privacy Policy acceptance (history). Server-only writes.
      match /consents/{id} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // In-app notifications (support replies, status changes). Created only by
      // the server; the owner can mark them read or delete them.
      match /notifications/{nid} {
        allow read, delete: if isOwner(uid);
        allow create: if false;
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read is bool;
      }

      match /conversations/{cid} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && (!('title' in request.resource.data) || smallString(request.resource.data.title, 200));

        match /messages/{mid} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && request.resource.data.role in ['user', 'assistant']
            && smallString(request.resource.data.content, 400000);
        }
      }

      match /memories/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && smallString(request.resource.data.text, 1000);
      }

      match /documents/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && smallString(request.resource.data.name, 300);

        // extracted chunks, embedded slide images, cached summaries, table rows
        match /{sub}/{subId} {
          allow read, write: if isOwner(uid) && sub in ['chunks', 'images', 'summaries', 'tables'];
        }
      }

      // Knowledge base (personal): collections, sources, and per-source chunks and index.
      match /kbCollections/{cid} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && smallString(request.resource.data.name, 100);
      }
      match /kbSources/{sid} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && smallString(request.resource.data.title, 300)
          && smallString(request.resource.data.collectionId, 128);
        match /{sub}/{subId} {
          allow read, write: if isOwner(uid) && sub in ['chunks', 'index'];
        }
      }

      // Generated images (Cloudflare Workers AI): metadata, and the image bytes in
      // separate documents. Created only by the server (which checks safety and
      // budgets first); the owner can read and delete them, never change them.
      match /generatedImages/{imageId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if false;
      }
      match /generatedImageData/{chunkId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if false;
      }

      // Usage counters enforce the per-user web-search budgets: the owner may
      // read them (usage dashboard); only the server writes them.
      match /usage/{day} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // projects, savedResponses, memoryVectors, convVectors, ...
      match /{collection}/{docId} {
        allow read, write: if isOwner(uid)
          && collection in ['projects', 'savedResponses', 'memoryVectors', 'convVectors', 'searchCache', 'projectMemory', 'convIndex'];
      }
    }

    // Access requests: one per account, written only by the server; admins can read.
    match /accessRequests/{rid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Administrator activity log: readable by admins, written only by the server.
    match /adminLogs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Support reports. Written only by the server (api/support.ts), which checks
    // ownership and administrator rights. A user can read only their own
    // reports, their conversation and screenshots; administrator notes and the
    // activity timeline are readable by administrators only.
    function ownsReport(rid) {
      return isAllowed()
        && get(/databases/$(database)/documents/supportReports/$(rid)).data.uid == request.auth.uid;
    }
    match /supportReports/{rid} {
      allow read: if isAdmin() || (isAllowed() && resource.data.uid == request.auth.uid);
      allow write: if false;
      match /messages/{mid} {
        allow read: if isAdmin() || ownsReport(rid);
        allow write: if false;
      }
      match /attachments/{aid} {
        allow read: if isAdmin() || ownsReport(rid);
        allow write: if false;
      }
      match /internal/{nid} {
        allow read: if isAdmin();
        allow write: if false;
      }
      match /activity/{eid} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // Notifications for administrators (new reports, user messages, high priority).
    match /adminNotifications/{nid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Help Centre articles edited by administrators through the server.
    match /helpArticles/{aid} {
      allow read: if isAllowed();
      allow write: if false;
    }

    // The server identity may read and write everything (rules combine with OR).
    match /{document=**} {
      allow read, write: if isServer();
    }
  }
}
