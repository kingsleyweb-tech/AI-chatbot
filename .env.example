# Copy to .env.local for local development. Never commit real values.

# --- Server-only secrets (Vercel env vars; never prefixed with VITE_) ---
OPENROUTER_API_KEY=
# Google Gemini (AI Studio) key, optional. Models appear as gemini:<model>.
GEMINI_API_KEY=
# Set to 'paid' if the Google project has billing enabled: every Gemini model then needs approval.
GEMINI_BILLING=
# Web search (optional). SerpAPI = general/news, Tavily = research/page reading.
SERPAPI_API_KEY=
TAVILY_API_KEY=
# Cloudflare Workers AI (optional): image generation/editing and selectable @cf/ chat models.
# Token needs only the "Workers AI: Read/Edit" permission. Server-only; never VITE_.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional: image model override (must be one listed in server/config/images.ts).
CLOUDFLARE_IMAGE_MODEL=
# --- Phone verification (SMS one-time codes for email/password accounts) ---
# Service account JSON for the Firebase project (raw JSON or base64). Server-only.
# Needed to set the phoneVerified custom claim and to keep code records private.
FIREBASE_SERVICE_ACCOUNT=
# Optional: Web API key the server uses to sign in as atlas-server (defaults to VITE_FIREBASE_API_KEY).
FIREBASE_WEB_API_KEY=
# 32+ random bytes, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_HMAC_SECRET=
# --- Account administration ---
# Secret Vercel Cron sends to /api/admin?job=purge (16+ characters). Without it,
# accounts scheduled for deletion are not purged automatically.
CRON_SECRET=
SMS_PROVIDER=vynfy
VYNFY_API_KEY=
VYNFY_SENDER_ID=
# 1 = Vynfy sandbox (not delivered, not charged), for testing
VYNFY_SANDBOX=
# Verification codes through Vynfy's OTP service (default 1). 0 = app codes sent as ordinary SMS.
# The OTP service has its own balance in the Vynfy dashboard (about GHS 0.09 per 6-digit code).
VYNFY_OTP=1
# OTP code length (4-8) and lifetime in minutes (1-60)
VYNFY_OTP_LENGTH=6
VYNFY_OTP_EXPIRY=5
# When the OTP balance is empty, send an app code by ordinary SMS instead (default 1; 0 disables)
VYNFY_OTP_FALLBACK=1
# Shared secret for Vynfy delivery webhooks (set the same value in the Vynfy dashboard).
# Webhook URL: https://<your-domain>/api/phone?webhook=vynfy
VYNFY_WEBHOOK_SECRET=
# App-wide maximum verification texts per day
OTP_DAILY_CAP=200

# Transactional email through Brevo (server-only; never a VITE_ variable).
# In Brevo: Security > Authorised IPs > turn off IP blocking (Vercel has no fixed IPs),
# and verify the sender address under Senders, Domains & Dedicated IPs.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Atlas AI
# App-wide maximum emails per day (the Brevo free plan allows 300)
EMAIL_DAILY_CAP=250
# App-wide maximum notification texts per day (support updates; verification codes use OTP_DAILY_CAP)
SMS_NOTIFY_DAILY_CAP=50
# Public address used for links and the logo inside emails (defaults to APP_URL, or the production URL)
PUBLIC_APP_URL=

# Public URL of the deployed app (sent to OpenRouter as HTTP-Referer)
APP_URL=http://localhost:5173
FIREBASE_PROJECT_ID=ai-app-6efa7
# Optional overrides (comma separated model ids)
# DEFAULT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# FALLBACK_MODELS=nvidia/nemotron-3.5-super-vl:free,google/gemma-4-26b-a4b-it:free
# UTILITY_MODEL=google/gemma-4-26b-a4b-it:free
# EMBEDDING_MODELS=nvidia/nemotron-3.5-embed-1b:free,openai/text-embedding-3-small

# --- Public Firebase web config (safe to expose; bundled into the client) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
